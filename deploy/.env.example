# --- required ---
# The address employees' computers and browsers use to reach this server.
DSH_PUBLIC_URL=https://dsh.example.com
# 32+ random characters. Encrypts stored keys; keep a backup — losing it makes them unreadable.
#   openssl rand -base64 48
DSH_SERVER_SECRET=
POSTGRES_PASSWORD=

DSH_TENANT_ID=default
DSH_TENANT_NAME=My Organisation

# --- identity source: Feishu, DingTalk or WeCom (ADR-0008) ---
# Members come from this directory and sign in with the same app.
# DSH_DIRECTORY=feishu
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# DSH_DIRECTORY=dingtalk
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# DINGTALK_CORP_ID=
# DSH_DIRECTORY=wecom
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_SECRET=
DSH_DIRECTORY_SYNC_MINUTES=15
# A run disabling more than this share of managed people waits for an administrator.
DSH_DIRECTORY_MAX_DISABLE_PERCENT=20

# --- sign-in (pick at least one: the identity source above, OIDC, or the dev login) ---
# Any OpenID Connect provider: Azure AD / Entra ID, Okta, Keycloak, Authing, ...
# Register the redirect URI  <DSH_PUBLIC_URL>/v1/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Company SSO
# Match members by an e-mail the provider does not mark as verified. Only for
# providers that never send email_verified and let only their admins set addresses.
OIDC_TRUST_EMAIL=0
# Create members on their first sign-in instead of requiring a CSV import.
DSH_AUTO_PROVISION=0
# Evaluation only: an e-mail form with no password. Never on a reachable server.
DSH_DEV_LOGIN=0

# First console login. Stops working once an administrator signs in through SSO; remove it then.
DSH_BOOTSTRAP_TOKEN=

# --- model gateway ---
# Employees never see the real model key: each person gets a personal key
# that is revoked when they are disabled.
#   direct  — this server is the gateway, in front of OpenAI-compatible APIs
#             (DeepSeek, Qwen/DashScope, Moonshot, Zhipu, an internal vLLM, ...).
#             Model routes in profiles point at <DSH_PUBLIC_URL>/llm/v1. More
#             upstreams, model prices, usage and limits are managed in the
#             console's model catalog; DSH_UPSTREAM_URL is the optional default.
#   litellm — the optional LiteLLM service below, for several providers,
#             budgets and guardrails.
#   none    — no personal keys; profiles carry routes and names only.
DSH_GATEWAY=direct
DSH_UPSTREAM_URL=https://api.deepseek.com/v1
DSH_UPSTREAM_KEY=
# Days, weeks and months of usage and limits follow this time zone.
DSH_TIMEZONE=Asia/Shanghai
# Requests one person may have running at once through the built-in gateway.
DSH_GATEWAY_MAX_CONCURRENT=8

# --- retention ---
# Days of per-request gateway records (0 keeps them).
DSH_REQUEST_RETENTION_DAYS=400
# Days of audit events (0 keeps them). Pruning leaves a checkpoint so the chain still verifies.
DSH_AUDIT_RETENTION_DAYS=0

LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=
# Profiles reference this credential name in their model routes.
DSH_GATEWAY_CREDENTIAL=DSH_ORG_GATEWAY_KEY
DSH_GATEWAY_KEY_DURATION=30d
# DSH_GATEWAY_MAX_BUDGET=50
