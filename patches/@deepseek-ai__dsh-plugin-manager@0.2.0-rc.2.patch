diff --git a/lib/types/desktop-pnpm.js b/lib/types/desktop-pnpm.js
new file mode 100644
index 0000000000000000000000000000000000000000..b26112cef958a3cb1e6377234b9b1c05752e1be0
--- /dev/null
+++ b/lib/types/desktop-pnpm.js
@@ -0,0 +1,15 @@
+import { execa as originalExeca } from "execa";
+// DSH Desktop supplies the bundled package manager before importing the CLI.
+// Rewrite structured argv before execa turns a Windows command into cmd.exe.
+export function execa(command, args, options) {
+  const runtime = globalThis[Symbol.for('dsh-desktop.pnpm')];
+  if (runtime && (command === 'pnpm' || command === 'pnpm.cmd')) {
+    return originalExeca(runtime.command, [...runtime.args, ...args], {
+      ...options,
+      shell: false,
+      windowsHide: process.platform === 'win32',
+      env: { ...options?.env, ...runtime.env },
+    });
+  }
+  return originalExeca(command, args, options);
+}
