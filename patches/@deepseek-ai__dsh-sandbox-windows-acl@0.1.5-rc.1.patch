diff --git a/lib/types-desktop-console.js b/lib/types-desktop-console.js
new file mode 100644
index 0000000000000000000000000000000000000000..f263e34b97b8cc0bfcafaf678f33ccf9209c516c
--- /dev/null
+++ b/lib/types-desktop-console.js
@@ -0,0 +1,31 @@
+// Desktop compatibility patch for bruc3van/dsh-desktop#16.
+// Keep a real console for restricted-token children: CREATE_NO_WINDOW is
+// incompatible with this sandbox. Never hide a console inherited from a CLI.
+const isNull = (pointer) => pointer === null || pointer === 0 || pointer === 0n;
+
+export function prepareRunnerConsole(api) {
+	if (isNull(api.getConsoleWindow())) {
+		// AllocConsole can replace the Win32 standard handles. The native spawn
+		// reads these handles, so preserve the runner's original stdio pipes.
+		const handles = [-10, -11, -12].map((selector) => [selector, api.getStdHandle(selector)]);
+		if (api.allocConsole() !== 0) {
+			try {
+				const window = api.getConsoleWindow();
+				if (!isNull(window)) api.showWindow(window, 0 /* SW_HIDE */);
+			} finally {
+				let restoreError;
+				for (const [selector, handle] of handles) {
+					if (api.setStdHandle(selector, handle) === 0) {
+						restoreError ??= new Error(`SetStdHandle failed (Win32 ${api.getLastError()})`);
+					}
+				}
+				if (restoreError) throw restoreError;
+			}
+		}
+	}
+	// Console allocation resets control handlers. Set this after allocation,
+	// including its best-effort failure path, before spawning any child.
+	if (api.setConsoleCtrlHandler(null, 1) === 0) {
+		throw new Error(`SetConsoleCtrlHandler failed (Win32 ${api.getLastError()})`);
+	}
+}
